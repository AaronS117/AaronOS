<Page
    x:Class="AaronOS.Modules.Finance.Views.RetirementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:data="clr-namespace:AaronOS.Modules.Finance.Data"
    xmlns:views="clr-namespace:AaronOS.Modules.Finance.Views"
    xmlns:vm="clr-namespace:AaronOS.Modules.Finance.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <views:NullableNumberConverter x:Key="Num" />

        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,8" />
        </Style>

        <!-- Field caption sitting above a small editor, so a row of numbers stays labelled. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!--
            Spin buttons are hidden throughout. They took roughly half the width of every editor on
            a page that is mostly editors, which clipped the values themselves — a retirement age of
            65 rendered as "6!" and an inflation rate of 2.5 as "2.". These are figures people type,
            not values they nudge one at a time, so the arrows cost more than they were worth.
        -->
        <Style TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
    </Page.Resources>

    <!-- No ScrollViewer: the shell's NavigationView already hosts pages in its own scroller. -->
    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Text="Retirement &amp; Savings"
                Style="{DynamicResource PageTitleText}"
                VerticalAlignment="Center" />
            <ui:Button
                Grid.Column="1"
                Content="Save"
                Command="{Binding SaveCommand}"
                Appearance="Primary"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Hero: what you have, and what is going in each year. -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="RETIREMENT BALANCE" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding TotalBalance, StringFormat=C}" Style="{DynamicResource HeroMetricText}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding AnnualContributionTotal, StringFormat='You {0:C0}/yr'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding AnnualEmployerMatch, StringFormat='Employer {0:C0}/yr'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding SavingsRatePercent, StringFormat='Saving {0:0.#}% of pay'}" Style="{DynamicResource CaptionText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource CaptionText}" Margin="0,0,0,14" />

        <!-- Planning assumptions -->
        <TextBlock Text="ASSUMPTIONS" Style="{DynamicResource EyebrowText}" Margin="0,8,0,10" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,26">
            <StackPanel>
                <!-- Wraps rather than clips: a row of fixed-width editors is wider than the card
                     once the window narrows, and a StackPanel silently cut the last one off. -->
                <WrapPanel>
                    <StackPanel Width="140" Margin="0,0,12,10">
                        <TextBlock Text="Annual salary" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.AnnualSalary, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="10000000" MaxDecimalPlaces="0" PlaceholderText="0" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,10">
                        <TextBlock Text="Age now" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.CurrentAge, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="14" Maximum="99" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,10">
                        <TextBlock Text="Retire at" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.TargetRetirementAge, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="15" Maximum="100" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,10">
                        <TextBlock Text="Return %" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.ExpectedReturnPercent, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="-20" Maximum="30" MaxDecimalPlaces="1" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,10">
                        <TextBlock Text="Inflation %" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.InflationPercent, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="-5" Maximum="25" MaxDecimalPlaces="1" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,0,10">
                        <TextBlock Text="Withdraw %" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Plan.WithdrawalRatePercent, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0.5" Maximum="20" MaxDecimalPlaces="1" />
                    </StackPanel>
                </WrapPanel>
                <CheckBox
                    Content="HSA is family coverage"
                    IsChecked="{Binding Plan.HasFamilyHsaCoverage, Mode=TwoWay}"
                    Margin="0,14,0,0" />
                <TextBlock
                    Text="Return and inflation are guesses about the future, so treat every projection below as a range rather than a number."
                    Style="{DynamicResource CaptionText}"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Projection -->
        <TextBlock Text="PROJECTION · TODAY'S DOLLARS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="12,14" Margin="0,0,0,26">
            <StackPanel>
                <Grid>
                    <lvc:CartesianChart
                        Height="260"
                        Series="{Binding ProjectionSeries}"
                        XAxes="{Binding ProjectionXAxes}"
                        YAxes="{Binding ProjectionYAxes}"
                        Background="Transparent"
                        Visibility="{Binding HasProjection, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        Text="{Binding ProjectionCaption}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="420"
                        TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProjection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Doubles as the chart legend, and carries the figures a legend would not. -->
                <ItemsControl
                    ItemsSource="{Binding Scenarios}"
                    Margin="6,14,6,0"
                    Visibility="{Binding HasProjection, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScenarioRow}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ReturnPercent, StringFormat='{}{0:0.#}%'}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding TodaysDollars, StringFormat=C0}" Style="{DynamicResource NumericText}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding MonthlyIncome, StringFormat='{}{0:C0}/mo income'}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Text="{Binding ProjectionCaption}"
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Margin="6,12,6,0"
                    Visibility="{Binding HasProjection, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Contribution caps -->
        <TextBlock Text="CONTRIBUTION CAPS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,14" Margin="0,0,0,26">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding LimitRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LimitRow}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOver}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Add an account with a yearly contribution and its cap will be checked here.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Text="{Binding LimitYearCaption}"
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Emergency fund, sized from real spending -->
        <TextBlock Text="EMERGENCY FUND" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,26">
            <StackPanel>
                <StackPanel Visibility="{Binding HasEmergencyGoal, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EmergencyMonthsDisplay}" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource NumericText}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:C0} of {1:C0}">
                                    <Binding Path="EmergencyBalance" />
                                    <Binding Path="EmergencyTarget" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Height="8" Margin="0,12,0,0" HorizontalAlignment="Left" Width="320">
                        <Rectangle
                            Width="{Binding EmergencyBarWidth}"
                            Height="8"
                            HorizontalAlignment="Left"
                            Fill="{DynamicResource ReactorGlow}"
                            RadiusX="4" RadiusY="4" />
                    </Border>
                    <TextBlock
                        Text="{Binding AverageMonthlySpend, StringFormat='Target is based on {0:C0} average monthly spend from your own transactions, ignoring transfers between your accounts and the current partial month.'}"
                        Style="{DynamicResource CaptionText}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,12,0,0" />
                </StackPanel>
                <TextBlock Text="Add a savings goal below and set its kind to Emergency fund to track this.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEmergencyGoal}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Retirement accounts -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ACCOUNTS" Style="{DynamicResource EyebrowText}" Margin="0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Add account" Command="{Binding AddAccountCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,0,26">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type data:RetirementAccount}">
                    <Border Style="{DynamicResource SurfaceCard}" Padding="16,14" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Account name"
                                    Margin="0,0,10,0" />
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding DataContext.AccountKinds, RelativeSource={RelativeSource AncestorType=Page}}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding Kind, Mode=TwoWay}"
                                    Margin="0,0,10,0" />
                                <ui:Button
                                    Grid.Column="2"
                                    Content="Remove"
                                    Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,12,10">
                                    <TextBlock Text="Balance" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding ManualBalance, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="100000000" MaxDecimalPlaces="2" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,12,10">
                                    <TextBlock Text="Your yearly" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding AnnualContribution, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="1000000" MaxDecimalPlaces="2" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,12,10">
                                    <TextBlock Text="Match %" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding EmployerMatchPercent, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="100" MaxDecimalPlaces="1" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10">
                                    <TextBlock Text="Up to % of pay" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding EmployerMatchLimitPercent, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="100" MaxDecimalPlaces="1" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,0,10">
                                    <TextBlock Text="Linked account (replaces balance)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox
                                        ItemsSource="{Binding DataContext.LinkableAccounts, RelativeSource={RelativeSource AncestorType=Page}}"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        SelectedValue="{Binding FinanceAccountId, Mode=TwoWay}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Savings goals -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SAVINGS GOALS" Style="{DynamicResource EyebrowText}" Margin="0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Add goal" Command="{Binding AddGoalCommand}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Goals}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type data:SavingsGoal}">
                    <Border Style="{DynamicResource SurfaceCard}" Padding="16,14" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    Grid.Column="0"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Goal name"
                                    Margin="0,0,10,0" />
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding DataContext.GoalKinds, RelativeSource={RelativeSource AncestorType=Page}}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding Kind, Mode=TwoWay}"
                                    Margin="0,0,10,0" />
                                <ui:Button
                                    Grid.Column="2"
                                    Content="Remove"
                                    Command="{Binding DataContext.RemoveGoalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,12,10">
                                    <TextBlock Text="Balance" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding ManualBalance, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="100000000" MaxDecimalPlaces="2" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,12,10">
                                    <TextBlock Text="Target amount" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding TargetAmount, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="100000000" MaxDecimalPlaces="2" PlaceholderText="auto" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,10">
                                    <TextBlock Text="Months of expenses" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding TargetMonthsOfExpenses, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="60" MaxDecimalPlaces="0" PlaceholderText="3" />
                                </StackPanel>
                                <StackPanel Width="130" Margin="0,0,12,10">
                                    <TextBlock Text="Monthly saving" Style="{StaticResource FieldLabel}" />
                                    <ui:NumberBox Value="{Binding MonthlyContribution, Mode=TwoWay, Converter={StaticResource Num}}" Minimum="0" Maximum="1000000" MaxDecimalPlaces="2" PlaceholderText="0" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,0,10">
                                    <TextBlock Text="Linked account (replaces balance)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox
                                        ItemsSource="{Binding DataContext.LinkableAccounts, RelativeSource={RelativeSource AncestorType=Page}}"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        SelectedValue="{Binding FinanceAccountId, Mode=TwoWay}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No savings goals yet. Add one to size an emergency fund from your real spending.">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasGoals}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Page>
