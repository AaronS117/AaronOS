<Page
    x:Class="AaronOS.Modules.Trading.Views.TradingActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:data="clr-namespace:AaronOS.Modules.Trading.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
    </Page.Resources>

    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <TextBlock Text="Activity" Style="{DynamicResource PageTitleText}" Margin="0,0,0,6" />
        <TextBlock
            Text="Every cycle is recorded, including the ones that decided to do nothing. Holding is the more common and usually the better call, and a log of only the trades would hide that."
            Style="{DynamicResource CaptionText}"
            TextWrapping="Wrap"
            Margin="0,0,0,22" />

        <!-- Orders -->
        <TextBlock Text="ORDERS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2" Margin="0,0,0,26">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:TradeOrder}">
                            <Grid Margin="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SubmittedAtUtc, StringFormat='{}{0:d MMM HH:mm}'}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Side}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Symbol}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Rationale}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="4" Text="{Binding Quantity, StringFormat='{}{0} sh'}" Style="{DynamicResource NumericText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding Status}" Style="{DynamicResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No orders yet." Margin="14,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Setter Property="Margin" Value="14,12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Decision log -->
        <TextBlock Text="DECISION LOG" Style="{DynamicResource EyebrowText}" />
        <ItemsControl ItemsSource="{Binding Decisions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type data:AgentDecision}">
                    <Border Style="{DynamicResource SurfaceCard}" Padding="16,13" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RanAtUtc, StringFormat='{}{0:d MMM HH:mm}'}" Style="{DynamicResource CaptionText}" Margin="0,0,14,0" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionSummary}" Style="{DynamicResource BodyText}" FontSize="13" />
                                <TextBlock Grid.Column="2" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} in / {1} out">
                                            <Binding Path="InputTokens" />
                                            <Binding Path="OutputTokens" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <TextBlock
                                Text="{Binding Reasoning}"
                                Style="{DynamicResource CaptionText}"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0" />

                            <TextBlock
                                Text="{Binding BlockedActions, StringFormat='Refused: {0}'}"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlockedActions}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Text="{Binding Error, StringFormat='Error: {0}'}"
                                TextWrapping="Wrap"
                                Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No cycles have run yet.">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDecisions}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Page>
