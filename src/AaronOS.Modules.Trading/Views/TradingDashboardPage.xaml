<Page
    x:Class="AaronOS.Modules.Trading.Views.TradingDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:AaronOS.Modules.Trading.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
    </Page.Resources>

    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Paper Trading" Style="{DynamicResource PageTitleText}" />
                <TextBlock
                    Text="Simulated money against the live market. Nothing here can spend real cash."
                    Style="{DynamicResource CaptionText}"
                    Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Run one cycle" Command="{Binding RunOnceCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <!-- Start and Stop swap places rather than sitting side by side, so the current
                     state is readable from which button is present. -->
                <ui:Button
                    Content="Start schedule"
                    Command="{Binding StartCommand}"
                    Appearance="Primary">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSchedulerRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Stop" Command="{Binding StopCommand}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSchedulerRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Keys missing: the page is inert until both are present, so say so rather than
             letting every button fail quietly. -->
        <Border
            Background="#2A2416"
            BorderBrush="#7A6A2E"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10"
            Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasKeys}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Text="Add your Alpaca paper key and a model provider in Settings before this can run. An Alpaca paper account is free and needs only an email, and the model can be a local Ollama server at no cost at all."
                Style="{DynamicResource BodyText}"
                FontSize="13"
                TextWrapping="Wrap" />
        </Border>

        <!-- The verdict leads, because the return on its own is not the answer. -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="VERSUS BUY AND HOLD" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                <!-- The hero here is a sentence, not a figure, so it takes the display face rather
                     than the monospace one the numeric readouts use. -->
                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HeroMetricText}">
                            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                            <Setter Property="FontSize" Value="26" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBehindBenchmark}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ReturnDisplay, StringFormat='Strategy {0}'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding BenchmarkDisplay, StringFormat='SPY {0}'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding DrawdownDisplay, StringFormat='Worst drawdown {0}'}" Style="{DynamicResource CaptionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding TradeCountDisplay}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding WinRateDisplay}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding StartedOnDisplay, StringFormat='Running since {0}'}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource CaptionText}" Margin="0,0,0,14" TextWrapping="Wrap" />

        <!-- Equity curve against the benchmark -->
        <TextBlock Text="GROWTH OF 100 · STRATEGY VS SPY" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="12,14" Margin="0,0,0,26">
            <Grid>
                <lvc:CartesianChart
                    Height="260"
                    Series="{Binding EquitySeries}"
                    XAxes="{Binding EquityXAxes}"
                    YAxes="{Binding EquityYAxes}"
                    Background="Transparent"
                    Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Text="Two days of history are needed before a curve means anything. Run a cycle and come back tomorrow."
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChart}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Positions -->
        <TextBlock Text="POSITIONS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,14" Margin="0,0,0,26">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Positions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PositionRow}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Symbol}" Style="{DynamicResource BodyText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} shares'}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MarketValue, StringFormat=C2}" Style="{DynamicResource NumericText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing held. Holding cash is a position too.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPositions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Settings and limits -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LIMITS AND STRATEGY" Style="{DynamicResource EyebrowText}" Margin="0" VerticalAlignment="Center" />
            <ui:Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}" Appearance="Primary" />
        </Grid>
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16">
            <StackPanel>
                <ui:ToggleSwitch
                    Content="Trading enabled"
                    IsChecked="{Binding Config.IsEnabled, Mode=TwoWay}"
                    Margin="0,0,0,14" />

                <TextBlock Text="Watchlist — the agent may not touch anything else" Style="{StaticResource FieldLabel}" />
                <ui:TextBox
                    Text="{Binding Config.Watchlist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="SPY,QQQ,AAPL"
                    Margin="0,0,0,14" />

                <WrapPanel>
                    <StackPanel Width="130" Margin="0,0,12,10">
                        <TextBlock Text="Max per position %" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Config.MaxPositionPercent, Mode=TwoWay}" Minimum="1" Maximum="100" MaxDecimalPlaces="1" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,10">
                        <TextBlock Text="Max invested %" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Config.MaxInvestedPercent, Mode=TwoWay}" Minimum="1" Maximum="100" MaxDecimalPlaces="1" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,0,12,10">
                        <TextBlock Text="Orders per day" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Config.MaxTradesPerDay, Mode=TwoWay}" Minimum="1" Maximum="50" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,10">
                        <TextBlock Text="Cycle minutes" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Config.CycleIntervalMinutes, Mode=TwoWay}" Minimum="1" Maximum="1440" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,10">
                        <TextBlock Text="Trades before stats" Style="{StaticResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding Config.MinTradesForStats, Mode=TwoWay}" Minimum="1" Maximum="500" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,12,10">
                        <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" />
                        <ComboBox
                            ItemsSource="{Binding ProviderNames}"
                            SelectedItem="{Binding Config.Provider, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,0,10">
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Config.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Strategy notes, passed to the agent each cycle" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                <ui:TextBox
                    Text="{Binding Config.StrategyNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="80" />

                <TextBlock
                    Text="These limits are enforced by the app before any order reaches the broker, not by asking the model to respect them. Autonomous means autonomous while AaronOS is open — closing the window stops the trading."
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
