<Page
    x:Class="AaronOS.Modules.Medical.Views.MedicalOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:AaronOS.Modules.Medical.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="14,12" />
        </Style>
    </Page.Resources>

    <!-- No ScrollViewer: the shell's DynamicScrollViewer owns page scrolling (see the note in
         FinanceDashboardPage.xaml). -->
    <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="28,20,28,32">

        <TextBlock Text="Medical" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!--
            Allergies come first and get their own card. This is the one item on the page whose whole
            purpose is to be seen before something goes wrong, so it is not a row in a list further
            down. The border turns red only when something is actually severe.
        -->
        <TextBlock Text="ALLERGIES" Style="{DynamicResource EyebrowText}" />
        <Border Padding="18,14" Margin="0,0,0,26">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSevereAllergy}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource ExpiryPast}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Allergies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:Allergy}">
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Substance}"
                                    Style="{DynamicResource BodyText}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding ReactionDisplay}"
                                    Style="{DynamicResource CaptionText}"
                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SeverityDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModerate}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSevere}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Absence is stated explicitly: a blank space here could be read as "none known"
                     when it actually means "never entered". -->
                <TextBlock Text="Nothing recorded yet — this is not the same as none known. Add any on the Medications page.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAllergies}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- At-a-glance counts -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,26">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTIVE CONDITIONS" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ActiveConditionCount}" Style="{DynamicResource HeroMetricText}" FontSize="26" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="MEDICATIONS" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding MedicationCount}" Style="{DynamicResource HeroMetricText}" FontSize="26" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LABS FLAGGED" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding FlaggedLabCount}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeroMetricText}">
                                    <Setter Property="FontSize" Value="26" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFlaggedLabs}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="{Binding LastVisitDisplay}"
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- Current medications -->
        <TextBlock Text="CURRENT MEDICATIONS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2" Margin="0,0,0,26">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ActiveMedications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:Medication}">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding DoseDisplay}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StartedDisplay}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No current medications recorded.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveMedications}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Only present when something is actually out of range. -->
        <StackPanel Visibility="{Binding HasFlaggedLabs, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="LABS OUT OF RANGE" Style="{DynamicResource EyebrowText}" />
            <Border Style="{DynamicResource SurfaceCard}" Padding="4,2">
                <ItemsControl ItemsSource="{Binding FlaggedLabs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:LabResult}">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TestName}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" Style="{DynamicResource NumericText}" Foreground="{DynamicResource ExpirySoon}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding RangeDisplay}" Style="{DynamicResource NumericText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding TakenDisplay}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
