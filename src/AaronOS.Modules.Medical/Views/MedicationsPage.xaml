<Page
    x:Class="AaronOS.Modules.Medical.Views.MedicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:data="clr-namespace:AaronOS.Modules.Medical.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="14,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="ImportedTag" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="8,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ReactorGlowDim}" />
        </Style>
    </Page.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="28,20,28,32">

        <TextBlock Text="Medications" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!-- Add a medication -->
        <TextBlock Text="ADD A MEDICATION" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="MEDICATION" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewMedicationName, Mode=TwoWay}" PlaceholderText="Lisinopril" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="DOSE" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewDose, Mode=TwoWay}" PlaceholderText="10 mg" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FREQUENCY" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewFrequency, Mode=TwoWay}" PlaceholderText="Once daily" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="PRESCRIBER" Style="{DynamicResource FieldLabel}" />
                        <ComboBox
                            ItemsSource="{Binding Providers}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding NewMedicationProvider, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="STARTED" Style="{DynamicResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding NewStartDate, Mode=TwoWay}" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Add" Command="{Binding AddMedicationCommand}" Appearance="Primary" VerticalAlignment="Bottom" MinWidth="80" />
                </Grid>
                <TextBlock
                    Text="Prescribers come from the Visits page — adding one there makes it selectable here."
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="MEDICATIONS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2" Margin="0,0,0,26">
            <StackPanel>
                <Grid Margin="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MEDICATION" Style="{DynamicResource EyebrowText}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="DOSE" Style="{DynamicResource EyebrowText}" Margin="0" />
                    <TextBlock Grid.Column="2" Text="STARTED" Style="{DynamicResource EyebrowText}" Margin="0" />
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="14,0,14,4" />
                <ItemsControl ItemsSource="{Binding Medications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:Medication}">
                            <!-- Past medications stay in the list but read dimmer than current ones. -->
                            <Grid Margin="14,9">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource BodyText}" FontSize="13" />
                                        <TextBlock Text="IMPORTED" Style="{DynamicResource ImportedTag}" Visibility="{Binding IsImported, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProviderDisplay}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DoseDisplay}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StartedDisplay}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Stopping dates the row rather than deleting it: history is the point. -->
                                    <Button
                                        Content="Stop"
                                        Style="{StaticResource RowAction}"
                                        Click="StopMedication_Click"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Remove" Style="{StaticResource RowAction}" Click="DeleteMedication_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing recorded yet.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedications}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Allergies -->
        <TextBlock Text="ADD AN ALLERGY" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="SUBSTANCE" Style="{DynamicResource FieldLabel}" />
                    <ui:TextBox Text="{Binding NewSubstance, Mode=TwoWay}" PlaceholderText="Penicillin" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="REACTION" Style="{DynamicResource FieldLabel}" />
                    <ui:TextBox Text="{Binding NewReaction, Mode=TwoWay}" PlaceholderText="Hives" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="SEVERITY" Style="{DynamicResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding NewSeverity, Mode=TwoWay}" />
                </StackPanel>
                <ui:Button Grid.Column="3" Content="Add" Command="{Binding AddAllergyCommand}" VerticalAlignment="Bottom" MinWidth="80" />
            </Grid>
        </Border>

        <TextBlock Text="ALLERGIES" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Allergies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:Allergy}">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Substance}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="IMPORTED" Style="{DynamicResource ImportedTag}" Visibility="{Binding IsImported, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ReactionDisplay}" Style="{DynamicResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SeverityDisplay}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModerate}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSevere}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Remove" Style="{StaticResource RowAction}" HorizontalAlignment="Right" Click="DeleteAllergy_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing recorded yet.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAllergies}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" Margin="0,12,4,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Page>
