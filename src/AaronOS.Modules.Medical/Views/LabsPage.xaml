<Page
    x:Class="AaronOS.Modules.Medical.Views.LabsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:data="clr-namespace:AaronOS.Modules.Medical.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="14,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="ImportedTag" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="8,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ReactorGlowDim}" />
        </Style>
    </Page.Resources>

    <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="28,20,28,32">

        <TextBlock Text="Labs" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!-- Trend for one test: the direction of travel is the point, not any single number. -->
        <TextBlock Text="TREND" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,26">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        ItemsSource="{Binding TestNames}"
                        SelectedItem="{Binding SelectedTestName, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding TrendSummary}"
                        Style="{DynamicResource CaptionText}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        Margin="12,0,0,0" />
                </Grid>

                <!-- Transparent so the card behind it shows through instead of LiveCharts' own white. -->
                <lvc:CartesianChart
                    Height="260"
                    Margin="0,14,0,0"
                    Series="{Binding TrendSeries}"
                    XAxes="{Binding TrendAxes}"
                    Background="Transparent"
                    Visibility="{Binding HasTrend, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="Add at least one dated numeric result to see a trend.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Margin" Value="0,12,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTrend}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Add a result -->
        <TextBlock Text="ADD A RESULT" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="TEST" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewTestName, Mode=TwoWay}" PlaceholderText="A1c" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="VALUE" Style="{DynamicResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding NewValue, Mode=TwoWay}" PlaceholderText="5.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="OR TEXT" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewValueText, Mode=TwoWay}" PlaceholderText="Negative" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="UNIT" Style="{DynamicResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewUnit, Mode=TwoWay}" PlaceholderText="%" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="REF LOW" Style="{DynamicResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding NewLow, Mode=TwoWay}" PlaceholderText="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="REF HIGH" Style="{DynamicResource FieldLabel}" />
                        <ui:NumberBox Value="{Binding NewHigh, Mode=TwoWay}" PlaceholderText="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="TAKEN ON" Style="{DynamicResource FieldLabel}" />
                        <DatePicker SelectedDate="{Binding NewTakenOn, Mode=TwoWay}" />
                    </StackPanel>
                    <ui:Button Grid.Column="4" Content="Add" Command="{Binding AddResultCommand}" Appearance="Primary" VerticalAlignment="Bottom" MinWidth="80" />
                </Grid>
                <TextBlock
                    Text="Leave the reference range blank if you do not have one — a result with no range is never flagged."
                    Style="{DynamicResource CaptionText}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- All results -->
        <TextBlock Text="RESULTS" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2">
            <StackPanel>
                <Grid Margin="14,10,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="190" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TEST" Style="{DynamicResource EyebrowText}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="RESULT" Style="{DynamicResource EyebrowText}" Margin="0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="RANGE" Style="{DynamicResource EyebrowText}" Margin="0" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="TAKEN" Style="{DynamicResource EyebrowText}" Margin="0" HorizontalAlignment="Right" />
                </Grid>
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="14,0,14,4" />
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type data:LabResult}">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="190" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding TestName}" Style="{DynamicResource BodyText}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="IMPORTED" Style="{DynamicResource ImportedTag}" Visibility="{Binding IsImported, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
                                            <Style.Triggers>
                                                <!-- Out of range is the whole reason to look at this list. -->
                                                <DataTrigger Binding="{Binding IsOutOfRange}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding RangeDisplay}" Style="{DynamicResource NumericText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding TakenDisplay}" Style="{DynamicResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="Remove" Style="{StaticResource RowAction}" Click="DeleteResult_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No results recorded yet.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResults}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" Margin="0,12,4,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</Page>
