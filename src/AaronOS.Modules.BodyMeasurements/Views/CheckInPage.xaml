<Page
    x:Class="AaronOS.Modules.BodyMeasurements.Views.CheckInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:AaronOS.Modules.BodyMeasurements.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Field label sitting above a NumberBox in the measurements grid. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Page.Resources>

    <!-- No ScrollViewer: the shell scrolls the page (see FinanceDashboardPage.xaml). -->
    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <TextBlock Text="Check In" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!--
            Weight leads: it is the thing logged most often, so the quickest path through this page is
            open, type, save. Everything else is optional and sits below.
        -->
        <TextBlock Text="WEIGHT" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,18" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox
                    x:Name="WeightBox"
                    Value="{Binding WeightLb, Mode=TwoWay}"
                    Width="180"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="30"
                    Minimum="0"
                    Maximum="1200"
                    MaxDecimalPlaces="1"
                    SpinButtonPlacementMode="Hidden" />
                <TextBlock
                    Text="lb"
                    Style="{DynamicResource CaptionText}"
                    FontSize="16"
                    VerticalAlignment="Bottom"
                    Margin="10,0,0,12" />
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="190">
                <TextBlock Text="DATE" Style="{DynamicResource EyebrowText}" Margin="0,0,0,6" />
                <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <ui:Button Content="Save check-in" Command="{Binding SaveCommand}" Appearance="Primary" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource CaptionText}" Margin="0,0,0,18" />

        <!-- Optional tape measurements. Leave any of them blank; only what you fill in is stored. -->
        <TextBlock Text="MEASUREMENTS · OPTIONAL, IN INCHES" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Neck" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding NeckIn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Chest" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding ChestIn, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Waist" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding WaistIn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Hips" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding HipsIn, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Bicep, left" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding BicepLeftIn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Bicep, right" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding BicepRightIn, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,14">
                    <TextBlock Text="Thigh, left" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding ThighLeftIn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                    <TextBlock Text="Thigh, right" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding ThighRightIn, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Calf, left" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding CalfLeftIn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1">
                    <TextBlock Text="Calf, right" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Value="{Binding CalfRightIn, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="NOTES" Style="{DynamicResource EyebrowText}" />
        <ui:TextBox
            Text="{Binding Notes, Mode=TwoWay}"
            PlaceholderText="Anything worth remembering about today"
            AcceptsReturn="True"
            Height="80" />
    </StackPanel>
</Page>
