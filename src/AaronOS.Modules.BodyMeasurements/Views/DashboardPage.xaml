<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AaronOS.Modules.BodyMeasurements.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:AaronOS.Modules.BodyMeasurements.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Body Measurements" />

            <StackPanel Orientation="Horizontal" Spacing="32">
                <StackPanel>
                    <TextBlock Text="Latest weight" Opacity="0.7" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.LatestWeightLb, Mode=OneWay, TargetNullValue='—'}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="BMI" Opacity="0.7" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.Bmi, Mode=OneWay, TargetNullValue='Set height in Settings'}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Last check-in" Opacity="0.7" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.LatestCheckInDate, Mode=OneWay, TargetNullValue='No check-ins yet'}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Weight trend" />
            <lvc:CartesianChart
                Height="260"
                Series="{x:Bind ViewModel.WeightSeries}"
                XAxes="{x:Bind ViewModel.WeightAxes}" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Active goals" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveGoals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GoalProgress">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                <ProgressBar Value="{x:Bind ProgressFraction}" Maximum="1" />
                                <TextBlock Text="{x:Bind ProgressText}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
