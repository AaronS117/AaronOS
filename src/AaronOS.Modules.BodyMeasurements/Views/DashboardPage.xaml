<Page
    x:Class="AaronOS.Modules.BodyMeasurements.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:vm="clr-namespace:AaronOS.Modules.BodyMeasurements.ViewModels"
    xmlns:views="clr-namespace:AaronOS.Modules.BodyMeasurements.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <!-- No ScrollViewer: WPF-UI's NavigationView already scrolls page content (see the note in
         FinanceDashboardPage.xaml — nesting one broke scrolling outright). -->
    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <TextBlock Text="Body Measurements" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!-- Current state: three readouts on one card, mono figures so they align. -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WEIGHT" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                    <TextBlock
                        Text="{Binding LatestWeightLb, StringFormat='{}{0:N1} lb', TargetNullValue='—'}"
                        Style="{DynamicResource HeroMetricText}"
                        FontSize="30" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="BMI" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                    <TextBlock
                        Text="{Binding Bmi, StringFormat='{}{0:N1}', TargetNullValue='—'}"
                        Style="{DynamicResource HeroMetricText}"
                        FontSize="30" />
                    <TextBlock Text="Set your height in Settings" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Bmi}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="LAST CHECK-IN" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                    <TextBlock
                        Text="{Binding LatestCheckInDate, StringFormat='{}{0:MMM d}', TargetNullValue='None yet'}"
                        Style="{DynamicResource BodyText}"
                        FontSize="18"
                        Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: the figure is the centrepiece of this module, so it gets the height. It always
             renders — average proportions, dimmed, when nothing is recorded yet — and both the model
             and the list beside it open the same inline editor. -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="BODY" Style="{DynamicResource EyebrowText}" Margin="0" />
            <TextBlock
                Grid.Column="1"
                Text="Drag to rotate · scroll to zoom · click a part to edit"
                Style="{DynamicResource CaptionText}"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <views:BodyModel3D x:Name="BodyModel" Grid.Column="0" Height="620" />

                <StackPanel Grid.Column="1" Width="252" Margin="24,0,0,0" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding MeasurementRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MeasurementRow}">
                                <!-- A button, not a label: the same edit affordance as the model itself. -->
                                <Button
                                    Click="MeasurementRow_Click"
                                    Tag="{Binding Metric}"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,7"
                                    Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{DynamicResource CaptionText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" MinWidth="70">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NumericText}">
                                                    <Style.Triggers>
                                                        <!-- Not-yet-recorded values recede rather than sitting at full contrast. -->
                                                        <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline editor, shown only once a part has been picked. -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ReactorGlow}"
                        Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EditorLabel}" Style="{DynamicResource BodyText}" FontSize="13" Margin="0,0,0,8" />
                            <ui:NumberBox
                                Value="{Binding EditorValue, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="120"
                                MaxDecimalPlaces="1"
                                SpinButtonPlacementMode="Hidden"
                                FontFamily="Cascadia Mono, Consolas"
                                Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Save" Command="{Binding SaveEditCommand}" Appearance="Primary" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding EditorStatus}" Style="{DynamicResource CaptionText}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Weight trend: a time series genuinely wants a line, so this stays a chart. -->
        <TextBlock Text="WEIGHT TREND" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="12,14" Margin="0,0,0,26">
            <Grid>
                <lvc:CartesianChart
                    Height="240"
                    Series="{Binding WeightSeries}"
                    XAxes="{Binding WeightAxes}"
                    Background="Transparent"
                    Visibility="{Binding HasWeightData, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    Text="Log a check-in with your weight and the trend will appear here."
                    HorizontalAlignment="Center"
                    Margin="0,28">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWeightData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Active goals -->
        <TextBlock Text="ACTIVE GOALS" Style="{DynamicResource EyebrowText}" />
        <StackPanel>
            <ItemsControl ItemsSource="{Binding ActiveGoals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GoalProgress}">
                        <Border Style="{DynamicResource SurfaceCard}" Margin="0,0,0,8" Padding="16,13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{DynamicResource BodyText}" FontSize="13" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ProgressText}"
                                        Style="{DynamicResource NumericText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ProgressBar
                                    Value="{Binding ProgressFraction}"
                                    Maximum="1"
                                    Height="4"
                                    Margin="0,10,0,0"
                                    Foreground="{DynamicResource ReactorGlow}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveGoals}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Text="No goals yet. Add one on the Goals page to track progress here."
                    Style="{DynamicResource CaptionText}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
