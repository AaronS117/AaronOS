<UserControl
    x:Class="AaronOS.Modules.BodyMeasurements.Views.BodySilhouette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Grid>
        <!-- Fixed logical size; the drawing code works in these coordinates and the Viewbox
             scales the whole thing to whatever room the layout gives it. -->
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="FigureCanvas" Width="220" Height="440" />
        </Viewbox>

        <TextBlock
            x:Name="NoDataLabel"
            Text="No measurements yet"
            Style="{DynamicResource CaptionText}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,4" />
    </Grid>
</UserControl>
