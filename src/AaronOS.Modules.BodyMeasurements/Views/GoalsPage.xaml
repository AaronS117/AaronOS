<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AaronOS.Modules.BodyMeasurements.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:AaronOS.Modules.BodyMeasurements.Data"
    mc:Ignorable="d">

    <Grid Padding="24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Goals" />
            <ComboBox Header="Metric" ItemsSource="{x:Bind ViewModel.Metrics}"
                      SelectedItem="{x:Bind ViewModel.NewMetric, Mode=TwoWay}" />
            <ComboBox Header="Direction" ItemsSource="{x:Bind ViewModel.Directions}"
                      SelectedItem="{x:Bind ViewModel.NewDirection, Mode=TwoWay}" />
            <NumberBox Header="Start value" Value="{x:Bind ViewModel.NewStartValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
            <NumberBox Header="Target value" Value="{x:Bind ViewModel.NewTargetValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
            <Button Content="Add Goal" Command="{x:Bind ViewModel.AddCommand}" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Goals}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:Goal">
                    <Grid ColumnSpacing="16" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Metric}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Direction}" Opacity="0.7" />
                        <TextBlock Grid.Column="2" Text="{x:Bind StartValue}" />
                        <Button Grid.Column="3" Content="Achieved" Click="AchievedButton_Click" />
                        <Button Grid.Column="4" Content="Delete" Click="DeleteButton_Click" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
