<Page
    x:Class="AaronOS.Modules.Nutrition.Views.NutritionDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AaronOS.Modules.Nutrition.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Margin" Value="14,12" />
        </Style>
    </Page.Resources>

    <!-- No ScrollViewer here on purpose: WPF-UI's NavigationView already hosts page content in its
         own DynamicScrollViewer (see the note in FinanceDashboardPage.xaml). Let the page grow. -->
    <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="28,20,28,32">

        <!-- Title row -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Nutrition" Style="{DynamicResource PageTitleText}" VerticalAlignment="Center" />
            <ui:Button
                Grid.Column="1"
                Content="Add recipe"
                Click="AddRecipeButton_Click"
                Appearance="Primary"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Hero: how many recipes you could cook right now, from what's actually in the kitchen. -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="CAN MAKE RIGHT NOW" Style="{DynamicResource EyebrowText}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding MakeableCount}" Style="{DynamicResource HeroMetricText}" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding RecipeTotal, StringFormat='{}{0} recipes'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding InventoryCount, StringFormat='{}{0} in inventory'}" Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="  ·  " Style="{DynamicResource CaptionText}" />
                    <TextBlock Text="{Binding RatedIngredientCount, StringFormat='{}{0} rated'}" Style="{DynamicResource CaptionText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Use it up: only appears when something is actually near its date. -->
        <StackPanel Visibility="{Binding HasExpiringSoon, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="USE IT UP" Style="{DynamicResource EyebrowText}" Margin="0,12,0,10" />
            <Border Style="{DynamicResource SurfaceCard}" Padding="4,2" Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding ExpiringSoon}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExpiringRow}">
                            <Grid Margin="14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding Name}"
                                    Style="{DynamicResource BodyText}"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Where}"
                                    Style="{DynamicResource CaptionText}"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding FreshnessText}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Foreground" Value="{DynamicResource ExpirySoon}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ExpiryPast}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- Filters -->
        <TextBlock Text="WHAT CAN I MAKE?" Style="{DynamicResource EyebrowText}" Margin="0,12,0,10" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    Content="Hide disliked"
                    IsChecked="{Binding ExcludeDisliked, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0" />
                <CheckBox
                    Content="Use it up first"
                    IsChecked="{Binding SortByUseItUp, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0" />
                <TextBlock
                    Text="Max cal / serving"
                    Style="{DynamicResource CaptionText}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" />
                <ui:NumberBox
                    Width="104"
                    Value="{Binding MaxCaloriesPerServing, Mode=TwoWay}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Recipes -->
        <Border Style="{DynamicResource SurfaceCard}" Padding="4,2">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding VisibleRecipes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecipeCard}">
                            <!-- Whole row is the hit target, styled flat so it reads as a ledger line. -->
                            <Button
                                Click="RecipeCard_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                                <Grid Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Recipe.Name}" Style="{DynamicResource BodyText}" />
                                            <!-- Marks the recipes that clear something out of the fridge. -->
                                            <TextBlock
                                                Text="USE IT UP"
                                                Style="{DynamicResource EyebrowText}"
                                                Foreground="{DynamicResource ExpirySoon}"
                                                FontSize="10"
                                                Margin="8,2,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding UseItUp, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Style="{DynamicResource CaptionText}" Margin="0,2,0,0">
                                            <Run Text="{Binding ServingsDisplay, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding IngredientCountDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock
                                            Text="{Binding TopConcern}"
                                            Style="{DynamicResource CaptionText}"
                                            Foreground="{DynamicResource ExpirySoon}"
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasConcern, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding StockSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <!-- Having everything is the good case, so it gets the positive colour. -->
                                                    <DataTrigger Binding="{Binding Stock.HasEverything}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource MoneyIn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding PerServing.Calories, StringFormat='{}{0:0}'}"
                                            Style="{DynamicResource NumericText}"
                                            FontSize="15" />
                                        <TextBlock
                                            Text="cal"
                                            Style="{DynamicResource CaptionText}"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No recipes yet. Choose Add recipe to build one from your ingredients.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecipes}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Discloses filtering rather than quietly showing a subset. -->
        <TextBlock
            Text="{Binding StatusMessage}"
            HorizontalAlignment="Right"
            Margin="0,10,4,0"
            Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}"
            Style="{DynamicResource CaptionText}"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</Page>
