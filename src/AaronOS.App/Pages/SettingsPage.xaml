<Page
    x:Class="AaronOS_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:AaronOS_App.Pages"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Stretch" Margin="28,20,28,32">

        <TextBlock Text="Settings" Style="{DynamicResource PageTitleText}" Margin="0,0,0,22" />

        <!-- Shared profile: values more than one module needs. -->
        <TextBlock Text="PROFILE" Style="{DynamicResource EyebrowText}" />
        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16" Margin="0,0,0,26">
            <StackPanel>
                <TextBlock
                    Text="Your height sets your BMI and the proportions of the body figure."
                    Style="{DynamicResource CaptionText}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12" />
                <!-- Feet and inches as separate fields, each with its own range. A single box labelled
                     "inches" invites a value like 6 meaning six feet, and there is no way to tell that
                     apart from a genuine entry once it is stored. -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="110" Margin="0,0,10,0">
                        <TextBlock Text="Height (feet)" Style="{DynamicResource CaptionText}" Margin="0,0,0,5" />
                        <ui:NumberBox
                            Value="{Binding HeightFeet, Mode=TwoWay}"
                            Minimum="2"
                            Maximum="8"
                            MaxDecimalPlaces="0"
                            PlaceholderText="5" />
                    </StackPanel>
                    <StackPanel Width="110" Margin="0,0,12,0">
                        <TextBlock Text="and inches" Style="{DynamicResource CaptionText}" Margin="0,0,0,5" />
                        <ui:NumberBox
                            Value="{Binding HeightInchesPart, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="11"
                            MaxDecimalPlaces="1"
                            PlaceholderText="11" />
                    </StackPanel>
                    <ui:Button
                        Content="Save"
                        Command="{Binding SaveCommand}"
                        Appearance="Primary"
                        VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource CaptionText}" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!--
            Module-contributed settings. Each module optionally returns a UserControl from
            IAppModule.SettingsContentType; the shell renders them here without knowing what any of
            them are, so a module's internal pages stay its own business.
        -->
        <ItemsControl ItemsSource="{Binding ModuleSections, RelativeSource={RelativeSource AncestorType=Page}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ModuleSettingsSection}">
                    <StackPanel Margin="0,0,0,26">
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource EyebrowText}" />
                        <Border Style="{DynamicResource SurfaceCard}" Padding="18,16">
                            <ContentControl Content="{Binding Content}" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
